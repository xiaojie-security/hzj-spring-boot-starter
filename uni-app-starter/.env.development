# 应用名称。
VITE_APPLICATION_NAME=应用程序名称
# 当前运行环境，合法值参见 OperatingEnvironment；开发环境默认 H5。
VITE_OPERATING_ENVIRONMENT=H5
# 是否记录请求与响应日志，生产环境建议关闭。
VITE_REQUEST_LOG_ENABLED=false
# 是否启用 SSL；开启后 http 自动升级为 https，ws 自动升级为 wss。
VITE_REQUEST_SSL_ENABLED=false
# 请求服务基础地址，例如 http://127.0.0.1:8080。
VITE_REQUEST_BASE_URL=
# 所有相对请求路径附加的公共前缀，例如 /api。
VITE_REQUEST_PREFIX=
# 时间戳请求头名称；留空时不携带该请求头。
VITE_REQUEST_TIMESTAMP_HEADER=
# 认证令牌请求头名称；留空时不携带该请求头。
VITE_REQUEST_AUTHORIZATION_HEADER=
# 随机串请求头名称；留空时不携带该请求头。
VITE_REQUEST_NONCE_HEADER=
# 设备 ID 请求头名称；留空时不携带该请求头。
VITE_REQUEST_DEVICE_ID_HEADER=
# 刷新令牌请求头名称；留空时不携带该请求头。
VITE_REQUEST_REFRESH_TOKEN_HEADER=
